  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=150%><b>[\uB2E8\uB3C5] 20\uB300 3\uBA85, \uD55C \uB2EC \uC0C8 \uC787\uB530\uB77C
    \uC758\uBB38\uC758 \uC8FD\uC74C... \uACBD\uCC30 \"\uB2E8\uC21C \uC0AC\uACE0\xB7\uC790\uC0B4\uB85C
    \uC885\uACB0\"</b></size>\r\n\r\n\uC9C0\uB09C\uB2EC\uBD80\uD130 20\uB300 \uB0A8\uC790
    3\uBA85\uC774 \uC11C\uB85C \uB2E4\uB978 \uC7A5\uC18C\uC5D0\uC11C \uC787\uB530\uB77C
    \uC228\uC9C4 \uCC44 \uBC1C\uACAC\uB3FC \uACBD\uCC30\uC774 \uC218\uC0AC\uC5D0
    \uB098\uC130\uC73C\uB098, \uD0C0\uC0B4 \uD610\uC758\uC810\uC744 \uCC3E\uC9C0
    \uBABB\uD574 \uB2E8\uC21C \uC0AC\uACE0 \uBC0F \uC790\uC0B4\uB85C \uB0B4\uC0AC\uB97C
    \uC885\uACB0\uD560 \uBC29\uCE68\uC774\uB2E4.\r\n\r\n\uACBD\uCC30 \uAD00\uACC4\uC790\uB294
    \"\uC138 \uC0AC\uB78C \uC0AC\uC774\uC5D0 \uC9C1\uC811\uC801\uC778 \uC811\uC810\uC740
    \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4\"\uACE0 \uBC1D\uD614\uB2E4. \uADF8\uB7EC\uB098
    \uCDE8\uC7AC \uACB0\uACFC \uC138 \uC0AC\uB78C\uC740 \uBAA8\uB450 \uAC19\uC740
    \uACE0\uB4F1\uD559\uAD50 \uCD9C\uC2E0\uC73C\uB85C, \uD55C \uB2EC \uC804 \uC5F4\uB9B0
    \uC878\uC5C5 10\uC8FC\uB144 \uB3D9\uCC3D\uD68C\uC5D0 \uD568\uAED8 \uCC38\uC11D\uD588\uB358
    \uAC83\uC73C\uB85C \uD655\uC778\uB410\uB2E4.\r\n\r\n\uC720\uAC00\uC871\uB4E4\uC740
    \uAC15\uD558\uAC8C \uBC18\uBC1C\uD558\uACE0 \uC788\uB2E4. \uC720\uAC00\uC871
    \uCE21\uC740 \"\uB3D9\uCC3D\uD68C \uC774\uD6C4\uBD80\uD130 \uC138 \uC0AC\uB78C
    \uBAA8\uB450 \uADF9\uC2EC\uD55C \uBD88\uC548 \uC99D\uC138\uB97C \uBCF4\uC600\uACE0,
    \uB204\uAD70\uAC00\uC5D0\uAC8C \uCAD3\uAE30\uB294 \uAC83 \uAC19\uB2E4\uB294 \uB9D0\uC744
    \uBC18\uBCF5\uD588\uB2E4\"\uBA70 \uC7AC\uC218\uC0AC\uB97C \uCD09\uAD6C\uD588\uB2E4.\r\n\r\n\uB2F9\uC2DC
    \uB3D9\uCC3D\uD68C\uC5D0 \uD568\uAED8 \uCC38\uC11D\uD588\uB358 \uD55C \uB3D9\uBB38\uC740
    \"\uD2B9\uBCC4\uD55C \uC77C\uC740 \uC5C6\uC5C8\uB2E4. \uC624\uB79C\uB9CC\uC5D0
    \uC61B \uBC18 \uCE5C\uAD6C\uB4E4, \uB2F4\uC784 \uC120\uC0DD\uB2D8\uACFC \uBAA8\uC5EC\uC11C
