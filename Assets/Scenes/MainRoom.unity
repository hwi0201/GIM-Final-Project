    \uCD9C\uC2E0 3\uBA85 \uBC0F \uAD50\uC0AC 1\uBA85 \uC0AC\uB9DD \uC0AC\uAC74 \uAD00\uB828
    \uC81C\uBCF4\uC785\uB2C8\uB2E4.\n\n\uC77C\uC120 \uACBD\uCC30\uC11C\uC5D0\uC11C\uB294
    \uD604\uC7A5 \uB2E8\uC11C\uAC00 \uC5C6\uC5B4 \uB2E8\uC21C \uC0AC\uACE0 \uBC0F
    \uC790\uC0B4\uB85C \uB0B4\uC0AC \uC885\uACB0\uD560 \uC608\uC815\uC785\uB2C8\uB2E4\uB9CC,
    \uCCA8\uBD80\uD55C 10\uB144 \uC804 \uC6D0\uBCF8 \uB370\uC774\uD130\uB4E4\uC744
    \uD655\uC778\uD558\uC2DC\uBA74 \uD574\uB2F9 \uC0AC\uAC74\uB4E4\uC774 \uBA85\uBC31\uD55C
    \uD0C0\uC0B4\uC784\uC744 \uC785\uC99D\uD558\uC2E4 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4.\n\n\uC5B8\uB860
    \uBCF4\uB3C4\uC5D0 \uD65C\uC6A9\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.\n"
